<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>AIKernel.Control.GPU</Title>
    <Description>GPU boundary package for AIKernel.Control. Provides the public Bonsai GPU execution delegate contract so CUDA, WebGPU, ROCm, Vulkan, or other device-specific backends can integrate without leaking into Control Core.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AIKernel.Dtos" Version="$(AIKernelContractPackageVersion)" />
    <PackageReference Include="AIKernel.Enums" Version="$(AIKernelContractPackageVersion)" />
    <ProjectReference Include="..\AIKernel.Control.Core\AIKernel.Control.Core.csproj" />
  </ItemGroup>
</Project>
